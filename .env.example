# ============================================================
# debuga-llm-gateway — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ============================================================

# Gateway server port
PORT=3100

# Preferred provider: cloud | local | auto
# - cloud: always route to cloud provider
# - local: always route to vLLM local
# - auto: try local first, fallback to cloud
PREFERRED_PROVIDER=cloud

# Enable local inference (vLLM)
ENABLE_LOCAL_INFERENCE=false

# Cloud provider (any OpenAI-compatible endpoint)
CLOUD_PROVIDER_URL=http://localhost:9000/v1
CLOUD_PROVIDER_API_KEY=your-cloud-provider-key

# Local vLLM instance
VLLM_URL=http://localhost:8000/v1

# Gateway API key (for authenticating clients)
GATEWAY_API_KEY=your-local-dev-key

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=60000
